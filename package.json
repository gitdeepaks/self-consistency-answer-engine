{
  "name": "self-consistency-answer-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "mkdir -p node_modules/.cache && concurrently --raw --kill-others --names api,worker,web \"bun run dev:server < /dev/null > node_modules/.cache/sce-server.log 2>&1\" \"bun run dev:worker < /dev/null > node_modules/.cache/sce-worker.log 2>&1\" \"bun run dev:web\"",
    "dev:tui": "mkdir -p node_modules/.cache && concurrently --raw --kill-others --names api,worker,cli \"bun run dev:server < /dev/null > node_modules/.cache/sce-server.log 2>&1\" \"bun run dev:worker < /dev/null > node_modules/.cache/sce-worker.log 2>&1\" \"bun run dev:cli\"",
    "dev:server": "bun --watch run packages/server/src/index.ts",
    "dev:worker": "bun --watch run packages/worker/src/index.ts",
    "dev:web": "bun run --filter @sce/web dev",
    "dev:cli": "bun --watch run packages/cli/src/index.tsx",
    "dev:logs": "tail -f node_modules/.cache/sce-server.log node_modules/.cache/sce-worker.log",
    "start": "bun run packages/server/src/index.ts",
    "start:worker": "bun run packages/worker/src/index.ts",
    "web": "bun run --filter @sce/web start",
    "cli": "bun run packages/cli/src/index.tsx",
    "ask": "bun run packages/cli/src/index.tsx",
    "dlq": "bun run packages/worker/src/cli.ts",
    "ops": "bun run packages/worker/src/cli.ts",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:nuke": "docker compose -f infra/docker-compose.yml down -v",
    "db:generate": "bun run --filter @sce/db db:generate",
    "db:migrate": "bun run --filter @sce/db db:migrate",
    "db:deploy": "bun run --filter @sce/db db:deploy",
    "db:status": "bun run --filter @sce/db db:status",
    "db:seed": "bun run --filter @sce/db db:seed",
    "auth:bootstrap": "bun run packages/db/src/bootstrap.ts",
    "auth:reconcile": "bun run packages/server/src/reconcile.ts",
    "db:studio": "bun run --filter @sce/db db:studio",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "scale-test": "bun run infra/scale-test.ts",
    "e2e": "bun run --filter @sce/web e2e"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bullmq": "^6.2.1",
    "concurrently": "^10.0.5",
    "ioredis": "^6.0.0",
    "typescript": "^5.9.3"
  }
}
