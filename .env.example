# ─── Model panel ───────────────────────────────────────────────────────────
# Provide each provider's own key, OR a single AI Gateway key that covers all
# three. Direct keys win when both are present. Any provider without a key is
# skipped (the run still proceeds with whoever is left).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# One key for all providers, via https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# ─── Model overrides (optional) ────────────────────────────────────────────
# OPENAI_MODEL=gpt-5.5
# ANTHROPIC_MODEL=claude-sonnet-5
# GOOGLE_MODEL=gemini-3.7-flash
# The evaluator that compares candidates and writes the final answer.
# EVALUATOR_MODEL=claude-opus-5

# ─── Server ────────────────────────────────────────────────────────────────
# PORT=8787
# HOST=0.0.0.0
# Comma-separated origins, or `*`. Phase 3 removes the `*` default.
# CORS_ORIGIN=*
# How long the API waits for in-flight requests on SIGTERM.
# SHUTDOWN_TIMEOUT_MS=20000

# Run the worker inside the API process. For a single machine, and for
# RUN_TRANSPORT=local. Off by default: the two scale on different signals.
# EMBED_WORKER=false

# ─── Queue and progress bus ────────────────────────────────────────────────
# `bun run db:up` starts the local Redis alongside Postgres.
# REDIS_URL=redis://localhost:6379

# `redis`  — the real queue and the durable progress bus. Any number of API
#            replicas and workers; runs survive a restart.
# `local`  — everything in one process. The migration escape hatch and the
#            path the test suite takes. Cannot scale past one replica.
# RUN_TRANSPORT=redis

# Key prefix, so several environments can share one Redis instance.
# REDIS_NAMESPACE=sce

# Candidate jobs one worker processes at once, and how hard the queue retries.
# QUEUE_CONCURRENCY=8
# QUEUE_MAX_ATTEMPTS=3
# QUEUE_BACKOFF_MS=2000
# Failed jobs kept for inspection and replay — this is the dead-letter queue.
# QUEUE_KEEP_FAILED=10000
# QUEUE_KEEP_COMPLETED=1000

# The live tail. Postgres is the archive, so this only has to bridge the gap
# between a client disconnecting and reconnecting.
# RUN_STREAM_MAX_LEN=2000
# RUN_STREAM_TTL_MS=900000
# RUN_STREAM_BLOCK_MS=15000

# ─── Worker: budgets and resilience ────────────────────────────────────────
# PER_MODEL_TIMEOUT_MS=120000
# EVALUATOR_TIMEOUT_MS=180000
# Budget for the whole run. Must be at least as large as the two above.
# RUN_DEADLINE_MS=600000
# MAX_OUTPUT_TOKENS=4000
# MAX_RETRIES=2

# Per-run ceilings, checked before every model call. 0 disables a ceiling.
# Cost is in micro-cents (1e-8 USD): 50000000 is $0.50.
# RUN_MAX_TOTAL_TOKENS=400000
# RUN_MAX_COST_MICRO_CENTS=50000000

# Bulkhead and circuit breaker: bound the damage one sick provider can do.
# PROVIDER_MAX_CONCURRENCY=4
# BREAKER_FAILURE_THRESHOLD=5
# BREAKER_COOLDOWN_MS=30000

# Streaming deltas are batched before they reach the bus — one frame per token
# would cost more than the generation it reports on.
# CANDIDATE_DELTA_FLUSH_MS=80
# CANDIDATE_DELTA_FLUSH_CHARS=256

# The deadline reaper: fails runs whose worker died between checkpoints.
# 0 disables it.
# REAPER_INTERVAL_MS=30000
# SHUTDOWN_TIMEOUT_MS=30000

# How long a worker caches the install-wide kill switch. It is consulted before
# every model call, so a per-step read would cost a query per candidate to watch
# a switch that is off essentially always.
# KILL_SWITCH_REFRESH_MS=10000

# Daily usage rollups, which the cost dashboard reads. 0 disables them: nothing
# enforces anything from these rows, so a stale rollup lags a report and can
# never let spend past a limit.
# USAGE_ROLLUP_INTERVAL_MS=300000

# ─── Metering, quotas and billing ──────────────────────────────────────────
# The install-wide daily spend cap, in micro-cents (1e-8 USD): 25000000000 is
# $250. This is the blast-radius control per-tenant quotas cannot be — a bug
# that fans out a thousand runs has nothing to do with any one plan. Reaching it
# engages a persisted kill switch that refuses new runs and stops the ones in
# flight, and only an operator releases it (`bun run ops resume`).
# 0 disables the cap; the API says so at boot in production.
# GLOBAL_DAILY_BUDGET_MICRO_CENTS=25000000000

# How long the API caches today's spend figure. The cost is bounded overshoot —
# at most one window's worth past the cap — against an aggregate over every
# metering row written today, on every single POST /runs.
# GLOBAL_BUDGET_REFRESH_MS=15000

# Dunning: how long a workspace keeps working after a payment fails. Afterwards
# it goes read-only — every GET still works and nothing is ever deleted.
# BILLING_GRACE_PERIOD_DAYS=7

# Rate limits. Operational and per-minute, unlike quotas, which are commercial
# and monthly: a tenant well inside its plan can still take the API down with a
# loop. The window slides, so a caller cannot spend two budgets across a
# boundary in two seconds.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_RUNS_PER_WINDOW=20
# RATE_LIMIT_READS_PER_WINDOW=300
# Per client IP, on top of the per-credential budget — the shape a
# credential-only limiter cannot see is one address minting keys in a loop.
# RATE_LIMIT_RUNS_PER_IP_PER_WINDOW=60

# ─── Database ──────────────────────────────────────────────────────────────
# Postgres. `bun run db:up` starts the local one from infra/docker-compose.yml,
# which is also the default when this is unset outside production.
# DATABASE_URL=postgresql://sce:sce@localhost:5432/sce?schema=public

# Answer bodies at or above this many bytes are written to object storage and
# the row keeps a pointer. Default 32768.
# LARGE_BODY_THRESHOLD_BYTES=32768
# Where the filesystem blob store writes. Default packages/db/.blobs
# BLOB_DIR=

# Tenant the bootstrap script creates and attributes its key to.
# SCE_DEFAULT_TENANT_SLUG=default

# ─── Identity (Clerk) ──────────────────────────────────────────────────────
# All optional. Without them the API still authenticates API keys — which is
# everything CI and the SDK need — but cannot accept a browser session or an
# OAuth token from `sce auth login`. Set both keys or neither: a half-configured
# identity provider accepts no sessions and reports no error, so the server
# refuses to boot in that state.
#
# Dashboard → API keys.
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...

# Dashboard → Webhooks → your endpoint's signing secret. Without it,
# POST /api/webhooks/clerk answers 503 rather than trusting unsigned payloads.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Dashboard → OAuth applications. Create a *public* client (no secret, PKCE
# only) with redirect URI http://127.0.0.1/callback, and paste its client id
# here. The CLI reads it from GET /api/auth/config, so no client-side config.
# See doc/runbooks/clerk-setup.md for the full walkthrough.
# CLERK_OAUTH_CLIENT_ID=

# Only for a proxied or custom-domain instance. Normally the authorization
# server's origin is decoded from the publishable key.
# CLERK_OAUTH_ISSUER=

# ─── HTTP ──────────────────────────────────────────────────────────────────
# Comma-separated origin allowlist. `*` is refused outside development — the
# API serves tenant-scoped data, so the origin list is part of the boundary.
# CORS_ORIGIN=http://localhost:3000

# ─── CLI ───────────────────────────────────────────────────────────────────
# SCE_SERVER_URL=http://localhost:8787
# A key for non-interactive use; overrides anything stored by `sce auth login`.
# SCE_API_KEY=
# Organization slug or id to act inside, for a user who belongs to several.
# SCE_TENANT=

# ─── Operations console (Phase 5) ──────────────────────────────────────────
# Who may reach the internal, cross-tenant console at /admin, by email address.
#
# This is a *separate axis* from tenant roles, and deliberately so. An `owner`
# is the most senior person inside one workspace; if that also meant "operator
# of the whole install", every customer's account owner would hold a
# cross-tenant view of every other customer — an escalation available to anyone
# who can sign up. Operator status therefore comes from configuration, which
# only somebody with deploy access can set.
#
# Empty (the default) means the console is unreachable for everyone, which is
# the right posture for an install that has not thought about it yet. Keyed by
# email rather than user id, because an address survives a database reset and a
# change of identity provider; a cuid does not.
# SCE_ADMIN_EMAILS=you@example.com,ops@example.com

# ─── Web app (Phase 5) ─────────────────────────────────────────────────────
# `NEXT_PUBLIC_*` variables are inlined into the browser bundle at build time,
# so they must be set when `next build` runs — not only at boot. None of them
# is a secret; they are public by construction.

# Where the browser reaches the Hono API. It calls it directly rather than
# through a Next route handler: the run stream is a long-lived SSE connection,
# and a serverless proxy in the middle of one buys nothing and times out.
# The API's CORS_ORIGIN above must name this app's origin.
# NEXT_PUBLIC_API_URL=http://localhost:8787

# This app's own origin. Share links are built server-side, and a link that
# says `localhost` in somebody's email is worthless. Not derived from the
# request host — that is attacker-controlled, and rewriting a share link is
# exactly what a forged `Host` header would be for.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# The same Clerk instance the API verifies against. Without it the app still
# boots and still serves share links; it simply cannot sign anybody in, and
# says so in words rather than throwing.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_…

# ─── End-to-end tests (Phase 5) ────────────────────────────────────────────
# All optional. Specs that need one of these skip themselves rather than
# failing, so a contributor with no backend still gets a useful `bun run e2e`.
#
# An already-running deployment to test against, instead of building locally.
# E2E_BASE_URL=https://staging.example.com
# A Clerk test-mode account, for the signed-in flows.
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
