{
  "uid": "sce-service", "title": "SCE Service", "schemaVersion": 40, "version": 1,
  "refresh": "30s", "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "POST /v1/runs requests / s", "type": "timeseries", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum by (status_class) (rate(sce_http_requests_total{method=\"POST\",route=\"/v1/runs\"}[5m]))"}]},
    {"id": 2, "title": "Run completion p95 (seconds)", "type": "timeseries", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(sce_run_duration_seconds_bucket[5m])))"}]},
    {"id": 3, "title": "Oldest waiting queue age (seconds)", "type": "timeseries", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "max by (queue) (sce_queue_age_seconds{state=\"wait\"})"}]},
    {"id": 4, "title": "SSE connections", "type": "timeseries", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum(sce_sse_connections)"}]}
  ]
}
