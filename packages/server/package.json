{
  "name": "@sce/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.12",
    "@hono/zod-validator": "^0.9.0",
    "@sce/db": "workspace:*",
    "@sce/queue": "workspace:*",
    "@sce/shared": "workspace:*",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@sce/worker": "workspace:*"
  }
}
