{
  "name": "@sce/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./handlers": "./src/handlers.ts"
  },
  "bin": {
    "sce-worker": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dlq": "bun run src/cli.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/google": "^4.0.49",
    "@ai-sdk/openai": "^4.0.45",
    "@sce/db": "workspace:*",
    "@sce/queue": "workspace:*",
    "@sce/shared": "workspace:*",
    "ai": "^7.0.73",
    "zod": "^4.4.3"
  }
}
