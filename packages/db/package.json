{
  "name": "@sce/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:deploy": "bunx --bun prisma migrate deploy",
    "db:status": "bunx --bun prisma migrate status",
    "db:studio": "bunx --bun prisma studio",
    "db:seed": "bun run src/seed.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sce/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  }
}
