{
  "name": "@sce/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "bunx --bun prisma generate",
    "db:push": "bunx --bun prisma db push",
    "db:studio": "bunx --bun prisma studio",
    "typecheck": "bunx tsc --noEmit",
    "db:reset": "bunx --bun prisma db push --force-reset"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sce/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  }
}
