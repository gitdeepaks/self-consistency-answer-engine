// Self-Consistency Answer Engine — persistence layer.
//
// A `Run` is one user prompt fanned out across the model panel. Each panel
// member produces a `Candidate`. A single `Synthesis` row holds the evaluator's
// comparison of those candidates plus the final merged answer.
//
// Everything a tenant owns hangs off `Tenant`, and every tenant-scoped table
// carries `tenantId` as the leading column of its hot index — isolation is a
// property of the schema, not of remembering to add a filter.
//
// The connection URL is supplied by `prisma.config.ts` so the Prisma CLI, the
// server and the tests all resolve it the same way from any working directory.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

/**
 * ----------------------------------------------------------------- enums
 */

/// Lifecycle of a whole run.
///
/// `PENDING` is the row the API writes; `QUEUED` is the acknowledgement that
/// the queue accepted the job. Keeping them distinct makes "the API took the
/// prompt but no worker ever picked it up" a state you can query for.
enum RunStatus {
  PENDING
  QUEUED
  FANNING_OUT
  SYNTHESIZING
  COMPLETE
  FAILED
  CANCELED
}

/// Lifecycle of a single panel member's answer.
enum CandidateStatus {
  PENDING
  RUNNING
  OK
  ERROR
  SKIPPED
  CANCELED
}

/// Panel members. Lowercase so the generated union matches `ProviderId` in
/// @sce/shared exactly, with no mapping layer and no cast.
enum ProviderId {
  openai
  anthropic
  google
}

enum MemberRole {
  owner
  admin
  member
  viewer
}

/// Who performed an audited action. Lowercase would not match the shared union;
/// these labels are identical on both sides so no mapping layer exists.
enum ActorType {
  USER
  API_KEY
  SYSTEM
}

/// What happened, in the append-only audit log. SCREAMING_SNAKE because a
/// dotted name is not a valid Postgres enum label, and a mapping layer between
/// the database and `auditActionSchema` is exactly where the two would drift.
enum AuditAction {
  AUTH_SUCCEEDED
  AUTH_FAILED
  API_KEY_CREATED
  API_KEY_REVOKED
  MEMBER_ADDED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  TENANT_CREATED
  TENANT_UPDATED
  TENANT_DELETED
  USER_SYNCED
  USER_DELETED
  RUN_CANCELED
  RUN_DELETED
  PLAN_CHANGED
  SUBSCRIPTION_UPDATED
  QUOTA_EXCEEDED
  BUDGET_TRIPPED
  KILL_SWITCH_RELEASED
}

/// Which leg of a run a metered model call belongs to.
enum UsageKind {
  CANDIDATE
  EVALUATOR
}

/// Commercial plans. Lowercase so the generated union matches `PlanId` in
/// @sce/shared exactly — the same no-mapping-layer argument as `ProviderId`.
enum PlanId {
  free
  pro
  team
  enterprise
}

/// Lifecycle of a paid subscription. SCREAMING_SNAKE to match the shared union;
/// `PAST_DUE` is the dunning state, and `graceEndsAt` is what bounds it.
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  PAUSED
}

/**
 * --------------------------------------------------------------- tenancy
 */

model Tenant {
  id         String    @id @default(cuid())
  /// URL-safe handle, unique across the install.
  slug       String    @unique
  name       String
  /// Clerk organization id. Null for tenants this install created itself — the
  /// bootstrap workspace, and anything seeded before an org existed upstream.
  externalId String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  memberships  Membership[]
  runs         Run[]
  usage        UsageRecord[]
  usageDaily   UsageDaily[]
  apiKeys      ApiKey[]
  auditEvents  AuditEvent[]
  subscription Subscription?

  @@index([createdAt])
}

model User {
  id          String  @id @default(cuid())
  email       String  @unique
  displayName String?
  /// Identity-provider subject (Clerk user id), populated in Phase 3.
  externalId  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  createdRuns    Run[]        @relation("RunCreatedBy")
  createdApiKeys ApiKey[]     @relation("ApiKeyCreatedBy")
}

model Membership {
  id       String     @id @default(cuid())
  tenantId String
  userId   String
  role     MemberRole @default(member)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

/**
 * ------------------------------------------------------------------ runs
 */

model Run {
  id              String  @id @default(cuid())
  tenantId        String
  /// Null until Phase 3 attaches a real principal to each request.
  createdByUserId String?

  prompt         String
  status         RunStatus @default(PENDING)
  error          String?
  temperature    Float?
  totalLatencyMs Int?

  /// Caller-supplied `Idempotency-Key`. A retried `POST /api/runs` carrying the
  /// same key returns this run instead of fanning out a second, identically
  /// expensive panel. Unique per tenant so two tenants never collide.
  idempotencyKey String?

  /// Wall-clock deadline for the whole run, enforced by the worker between
  /// steps and as an `AbortSignal` during every model call. Set at creation
  /// from `RUN_DEADLINE_MS`.
  deadlineAt DateTime?

  /// Per-run ceilings, enforced in the worker before each model call. Stored on
  /// the run rather than read from worker config so a plan (Phase 4) can raise
  /// or lower them per tenant without a redeploy, and so a historical run still
  /// records the ceiling it actually ran under.
  maxTotalTokens    Int?
  maxCostMicroCents BigInt?

  /// Set when a caller cancels. The worker observes it between steps; the
  /// cancellation is also published on Redis pub/sub so an in-flight model call
  /// aborts immediately rather than at the next checkpoint.
  canceledAt   DateTime?
  cancelReason String?

  /// Monotonic allocator for `RunEvent.seq`. Incremented inside the same
  /// transaction that writes the event, so sequence numbers are gap-free even
  /// with several workers appending to one run.
  eventSeq Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User?         @relation("RunCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  candidates Candidate[]
  synthesis  Synthesis?
  events     RunEvent[]
  usage      UsageRecord[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([createdByUserId])
  /// Reaper query: find runs past their deadline that no worker finished.
  @@index([status, deadlineAt])
}

model Candidate {
  id    String @id @default(cuid())
  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  provider ProviderId
  label    String
  model    String
  status   CandidateStatus @default(PENDING)

  /// Panel order. Several candidates are inserted in one statement and share a
  /// `createdAt` to the millisecond, so timestamps cannot order them — and an
  /// answer panel that shuffles between reads is a real bug, not a cosmetic one.
  position Int @default(0)

  /// Inline answer body. Null when the body exceeded the inline threshold and
  /// was offloaded — see `contentRef`.
  content      String?
  /// Object-store key for an offloaded answer body.
  contentRef   String?
  /// Size of the answer body in bytes, inline or offloaded.
  contentBytes Int?

  error        String?
  latencyMs    Int?
  inputTokens  Int?
  outputTokens Int?

  /// Queue delivery attempts spent on this candidate. Recorded on the row (not
  /// just in the queue) so the attempt count survives job eviction and shows up
  /// in the run inspector next to the error it produced.
  attempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, provider])
  @@unique([runId, position])
  @@index([runId])
}

model Synthesis {
  id    String @id @default(cuid())
  runId String @unique
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  model String

  /// Inline final answer, or null when offloaded to `finalAnswerRef`.
  finalAnswer      String?
  finalAnswerRef   String?
  finalAnswerBytes Int?

  /// string[] — claims every model converged on.
  agreements    Json  @default("[]")
  /// string[] — points of conflict and their resolution.
  disagreements Json  @default("[]")
  /// CandidateReview[] — per-candidate scoring.
  reviews       Json  @default("[]")
  confidence    Float @default(0)

  latencyMs    Int?
  inputTokens  Int?
  outputTokens Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ---------------------------------------------------- durable event log
 */

/// Append-only progress log for a run.
///
/// The in-process buffer this replaces died with the process that owned it, so
/// only the replica that started a run could serve its stream. Persisting the
/// same append-only-plus-cursor shape means any replica can replay any run, and
/// a restart mid-run loses nothing.
model RunEvent {
  id    String @id @default(cuid())
  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// 1-based position in this run's stream.
  seq       Int
  /// `RunEvent["type"]` from @sce/shared. Free-text because the union's dotted
  /// names ("run.snapshot") are not valid Postgres enum labels.
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([runId, seq])
}

/**
 * ------------------------------------------------------- usage and cost
 */

/// One metered model call. Retained after its run is deleted so that billing
/// and cost dashboards stay correct — hence the nullable `runId`.
model UsageRecord {
  id       String  @id @default(cuid())
  tenantId String
  runId    String?

  candidateId String?
  kind        UsageKind
  provider    ProviderId
  model       String

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  /// Cost in micro-cents (1e-8 USD). BigInt because a monthly rollup overflows
  /// a 32-bit integer long before it overflows a plausible invoice.
  costMicroCents BigInt  @default(0)
  /// The `ModelPrice` row this cost was derived from. Null means the model had
  /// no known price — the signal an unpriced model has appeared in production.
  priceId        String?

  createdAt DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    Run?        @relation(fields: [runId], references: [id], onDelete: SetNull)
  price  ModelPrice? @relation(fields: [priceId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([runId])
  @@index([model, createdAt])
  /// Global daily spend guard: one range scan across every tenant.
  @@index([createdAt])
}

/// Versioned price list. Prices are added, never edited, so a historical
/// `UsageRecord` can always be re-derived from the price that was in force.
model ModelPrice {
  id       String     @id @default(cuid())
  provider ProviderId
  model    String

  /// Micro-cents per 1,000,000 input tokens.
  inputPerMillion  BigInt
  /// Micro-cents per 1,000,000 output tokens.
  outputPerMillion BigInt

  effectiveFrom DateTime
  /// False for a placeholder that has not been checked against the vendor's
  /// published price list. Placeholders must not be used to bill anyone.
  verified      Boolean  @default(false)

  createdAt DateTime @default(now())

  usage UsageRecord[]

  @@unique([provider, model, effectiveFrom])
  @@index([model, effectiveFrom])
}

/// Per-tenant, per-day, per-model rollup of `UsageRecord`.
///
/// The metering table answers "what did this call cost"; this one answers "what
/// did last month cost, by model" without scanning every row of it. Rollups are
/// recomputed idempotently by the worker rather than incremented on write, so a
/// retried job, a late-arriving record or a backfill all converge on the same
/// numbers instead of double-counting.
model UsageDaily {
  id       String   @id @default(cuid())
  tenantId String
  /// Midnight UTC of the day being summarised.
  day      DateTime @db.Date

  provider ProviderId
  model    String

  calls          Int    @default(0)
  inputTokens    Int    @default(0)
  outputTokens   Int    @default(0)
  costMicroCents BigInt @default(0)

  /// When this row was last recomputed — the "as of" a dashboard has to show.
  rolledUpAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, day, provider, model])
  @@index([tenantId, day])
  @@index([day])
}

/**
 * ---------------------------------------------------- plans and billing
 */

/// What a tenant pays for, and whether they are paid up.
///
/// One row per tenant, created lazily: a tenant with no row is on the free plan
/// and active, which is the honest reading of "nobody has ever billed them" and
/// keeps every read total. The provider ids are stored so an inbound webhook
/// can find the tenant it is about without a second lookup service.
model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique

  plan   PlanId             @default(free)
  status SubscriptionStatus @default(ACTIVE)

  /// Billing-provider identifiers (Clerk Billing, or Stripe). Unique because
  /// they are how a webhook resolves its tenant, and two tenants sharing one
  /// customer id would make that resolution ambiguous.
  externalCustomerId     String? @unique
  externalSubscriptionId String? @unique

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  /// End of the dunning window opened by a failed payment. Until it passes, a
  /// `PAST_DUE` tenant keeps full access; after it, writes stop and reads do
  /// not. Null on every status but `PAST_DUE`.
  graceEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// A named, install-global stop.
///
/// The global daily budget cap trips `global.spend`, and the API refuses new
/// runs until an operator releases it. Persisted rather than held in memory
/// because it has to hold across every replica and survive the restart that an
/// incident usually involves — and because "who stopped it, when, and why" is
/// the first thing anybody asks.
model KillSwitch {
  /// The scope name from `killSwitchScopeSchema` in @sce/shared.
  scope String @id

  engaged Boolean @default(false)
  reason  String?

  engagedAt  DateTime?
  releasedAt DateTime?
  updatedAt  DateTime  @updatedAt
}

/**
 * ------------------------------------------------- credentials and audit
 */

/// A long-lived credential for a non-interactive caller: CI, the SDK, a script.
///
/// Humans at a terminal authenticate through Clerk's OAuth + PKCE flow instead
/// and never hold one of these. The row stores a *prefix* and a SHA-256 of the
/// secret, so a dump of this table authenticates nobody — see `apikey.ts` in
/// @sce/shared for why a fast hash is the right choice for a 256-bit random
/// secret and the wrong one for anything a human picked.
model ApiKey {
  id              String  @id @default(cuid())
  tenantId        String
  /// The person who minted it, kept so a departing employee's keys are findable.
  /// Null for a key created by the bootstrap script, which has no principal.
  createdByUserId String?

  /// Human label. A key nobody can identify is a key nobody dares revoke.
  name String

  /// `sce_live_a1b2c3d4e5f6` — the public half. Unique because it is the lookup
  /// key: verification is one indexed read plus one constant-time compare, not
  /// a scan over every key in the table.
  prefix String @unique
  /// SHA-256 of the secret half, hex. The secret itself is never stored.
  hash   String

  /// Scopes from `scopeSchema` in @sce/shared. A `String[]` rather than an enum
  /// array because the values contain colons, which Postgres enum labels cannot.
  /// Parsed by `storedScopesSchema` on the way out — an unreadable entry is
  /// dropped, which fails closed.
  scopes String[]

  /// Set on use, not on every request: the write is best-effort and throttled,
  /// because an exact timestamp is not worth a row update per API call.
  lastUsedAt DateTime?
  /// Null means the key does not expire.
  expiresAt  DateTime?
  /// Revocation is a timestamp, not a delete: the row has to outlive the key so
  /// the audit trail still resolves which credential did what.
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([createdByUserId])
}

/// Append-only record of anything worth answering "who did that?" about.
///
/// No `updatedAt`, and nothing in the application updates or deletes a row:
/// an audit log that can be edited by the system it audits is decoration. The
/// tenant is nullable so an authentication failure — which by definition has no
/// resolved tenant yet — is still recorded rather than silently dropped.
model AuditEvent {
  id       String  @id @default(cuid())
  tenantId String?

  action    AuditAction
  actorType ActorType
  /// User id, ApiKey id, or null for SYSTEM.
  actorId   String?

  /// What was acted on — "run", "api_key", "membership" — and which one.
  resourceType String?
  resourceId   String?

  /// Request provenance. Both are attacker-controlled strings; they are stored
  /// for correlation, never trusted for a decision.
  ip        String?
  userAgent String?

  /// Anything action-specific: the role before and after a change, the reason a
  /// run was canceled, the scopes a key was granted.
  metadata Json @default("{}")

  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

/// Webhook deliveries already processed, keyed by the Svix message id.
///
/// Svix retries on failure, and a retry of `organizationMembership.updated`
/// that ran once already must not run twice. The id is the primary key, so the
/// dedupe is an insert that either succeeds or conflicts — no read-then-write
/// race between two API replicas receiving the same retry.
model WebhookDelivery {
  /// The `svix-id` header. Supplied, not generated: that is the point.
  id         String   @id
  type       String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}
